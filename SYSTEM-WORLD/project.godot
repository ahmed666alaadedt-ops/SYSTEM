; SYSTEM WORLD
; Initial 3D project configuration

config_version=5

[application]

config/name="SYSTEM WORLD"
run/main_scene="res://MainScene.tscn"

[autoload]

GreedIslandCollisionGuard="*res://scripts/greed_island_collision_guard.gd"
GreedIslandStarGates="*res://scripts/greed_island_star_gates.gd"
GreedIslandAdminReturnUI="*res://scripts/greed_island_admin_return_ui.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
