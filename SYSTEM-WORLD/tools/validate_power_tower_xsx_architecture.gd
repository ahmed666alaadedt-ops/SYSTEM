extends SceneTree

const ArchitectureScript = preload("res://scripts/system_power_tower_xsx_architecture.gd")
const CompetitionManagerScript = preload("res://scripts/system_power_tower_competition_manager.gd")

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	var tower := Node3D.new()
	tower.name = "PowerTower"
	tower.set_meta("tower_id", "power_tower_baghdad")
	tower.set_meta("tower_floor_count", 200)
	tower.set_meta("tower_is_connected_district_member", false)
	var lobby := Node3D.new()
	lobby.name = "PublicLobby_Blockout"
	tower.add_child(lobby)
	var architecture := ArchitectureScript.new()
	tower.add_child(architecture)
	root.add_child(tower)
	await process_frame
	assert(bool(architecture.get_meta("system_power_tower_independent_landmark", false)))
	assert(int(architecture.get_meta("system_power_tower_floor_count", 0)) == 200)
	assert(int(architecture.get_meta("system_power_tower_structural_tier_count", 0)) == 3)
	assert(int(architecture.get_meta("system_power_tower_facade_rib_count", 0)) == 64)
	assert(int(architecture.get_meta("system_power_tower_floor_light_band_count", 0)) == 15)
	assert(int(architecture.get_meta("system_power_tower_arrival_media_panel_count", 0)) == 4)
	assert(int(architecture.get_meta("system_power_tower_xsx_facade_sign_count", 0)) == 12)
	assert(architecture.get_node_or_null("SkyObservatory") != null)
	assert(architecture.get_node_or_null("PowerTowerRooftopHelipad") != null)
	assert(architecture.get_node_or_null("XSXCircularEntrancePodium") != null)
	var interior := lobby.get_node_or_null("XSXShopAndCafeteriaInterior") as Node3D
	assert(interior != null)
	assert(int(architecture.get_meta("system_power_tower_lobby_light_bar_count", 0)) == 5)
	assert(int(architecture.get_meta("system_power_tower_lobby_floor_inlay_count", 0)) == 2)
	assert(int(architecture.get_meta("system_power_tower_lobby_ceiling_halo_count", 0)) == 3)
	assert(int(architecture.get_meta("system_power_tower_interior_directory_sign_count", 0)) == 6)
	assert(int(architecture.get_meta("system_power_tower_interior_accent_light_count", 0)) == 6)
	for facility_name in ["TraditionalWeaponsGallery", "ArmorShowroom", "NenElixirCabinet", "SkillScrollLibrary", "HunterAccessoriesGallery", "PowerTowerCafeteria", "PowerTowerNenTrainingHall"]:
		assert(interior.get_node_or_null(facility_name) != null, "Missing Power Tower interior facility: " + facility_name)
	assert(int(architecture.get_meta("system_power_tower_cafeteria_table_count", 0)) == 4)
	var weapons_gallery := interior.get_node_or_null("TraditionalWeaponsGallery")
	assert(weapons_gallery != null)
	assert(int(weapons_gallery.get_meta("system_traditional_equipment_display_count", 0)) == 3)
	assert(weapons_gallery.get_node_or_null("TraditionalSpearDisplay") != null)
	assert(weapons_gallery.get_node_or_null("TraditionalBowDisplay") != null)
	assert(weapons_gallery.get_node_or_null("TraditionalShieldDisplay") != null)
	var armor_showroom := interior.get_node_or_null("ArmorShowroom")
	assert(armor_showroom != null)
	assert(int(armor_showroom.get_meta("system_footwear_display_count", 0)) == 5)
	assert(armor_showroom.get_node_or_null("FootwearProgressionSign") != null)
	assert(int(architecture.get_meta("system_power_tower_cafeteria_seat_count", 0)) == 16)
	assert(interior.get_node_or_null("PowerTowerCombatStyleBoard") != null)
	var combat_board := interior.get_node_or_null("PowerTowerCombatStyleBoard")
	assert(combat_board.get_node_or_null("CombatStyleBoardInteraction") != null)
	var nen_hall := interior.get_node_or_null("PowerTowerNenTrainingHall")
	assert(nen_hall != null)
	assert(nen_hall.get_node_or_null("NenTrainingInteractionArea") != null)
	assert(str(nen_hall.get_meta("system_interaction_action", "")) == "POWER_TOWER_NEN_TRAINING")
	assert(not bool(architecture.get_meta("system_power_tower_shop_modern_firearms_allowed", true)))

	var competition := CompetitionManagerScript.new()
	tower.add_child(competition)
	await process_frame
	assert(bool(competition.get_meta("system_power_tower_independent", false)))
	assert(int(competition.get_meta("system_power_tower_floor_count", 0)) == 200)
	assert(int(competition.get_meta("system_power_tower_spectator_npc_target", 0)) == 500)

	var spectator_crowd := competition.get_node_or_null("PowerTower500SpectatorNPCs")
	assert(spectator_crowd != null)
	assert(int(spectator_crowd.get_meta("system_visible_spectator_count", 0)) == 500)
	var grandstands := spectator_crowd.get_node_or_null("PowerTowerFiveTierSpectatorGrandstands")
	assert(grandstands != null)
	assert(int(grandstands.get_meta("system_grandstand_tier_count", 0)) == 5)
	assert(int(grandstands.get_meta("system_grandstand_seat_capacity", 0)) == 500)
	assert(int(grandstands.get_meta("system_grandstand_deck_count", 0)) == 500)
	assert(int(grandstands.get_meta("system_grandstand_seat_count", 0)) == 500)
	assert(int(grandstands.get_meta("system_grandstand_backrest_count", 0)) == 500)
	assert(grandstands.get_node_or_null("GrandstandSpectatorSeats500") != null)
	var seat_instance := grandstands.get_node("GrandstandSpectatorSeats500") as MultiMeshInstance3D
	var first_seat_transform := seat_instance.multimesh.get_instance_transform(0)
	print("Grandstand seat diagnostic: origin=", first_seat_transform.origin, " basis_x=", first_seat_transform.basis.x, " basis_z=", first_seat_transform.basis.z, " tangent_dot=", absf(first_seat_transform.basis.x.normalized().dot(Vector3.BACK)))
	assert(absf(first_seat_transform.basis.x.dot(Vector3.BACK)) > 0.95, "Grandstand seat width must run tangentially around the arena")
	assert(first_seat_transform.basis.z.dot(Vector3.RIGHT) > 0.95, "Grandstand seat back must face outward and spectator must face inward")
	assert(str(competition.get_meta("system_power_tower_combat_styles", []).size()) == "6")
	var arena_root := competition.get_node_or_null("PowerTowerProgressiveArenaFloors")
	assert(arena_root != null)
	assert(int(arena_root.get_meta("system_arena_instance_count", 0)) == 560)
	assert(int(arena_root.get_meta("system_arena_combat_ring_outline_count", 0)) == 560)
	assert(arena_root.get_node_or_null("ArenaCombatRingOutlines560") != null)
	assert(int(arena_root.get_meta("system_arena_boundary_rail_count", 0)) == 2240)
	assert(int(arena_root.get_meta("system_arena_tier_marker_count", 0)) == 7)
	assert(str(arena_root.get_meta("system_arena_match_format", "")) == "PLAYER_ONLY_1V1")
	for floor_number in [1, 21, 41, 61, 81, 101, 151]:
		assert(arena_root.get_node_or_null("ArenaTierMarker_%03d" % floor_number) != null)
	print("X-S-X POWER TOWER ARCHITECTURE VALIDATION PASSED: 200-floor identity, tapered tiers, 12 facade marks, observatory, helipad, circular podium, shop galleries, lobby wayfinding, 560 arena layouts, seven arena progression signs, 500 spectator target and five-tier 500-seat grandstands.")
	quit(0)
