rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validPlayerData(uid) {
      return request.resource.data.keys().hasAll([
        'userId',
        'displayName',
        'email',
        'avatarUrl',
        'createdAt'
      ])
      &&
      request.resource.data.keys().hasOnly([
        'userId',
        'displayName',
        'email',
        'avatarUrl',
        'createdAt'
      ])
      &&
      request.resource.data.userId == uid
      &&
      request.resource.data.displayName is string
      &&
      request.resource.data.displayName.size() >= 1
      &&
      request.resource.data.displayName.size() <= 40
      &&
      request.resource.data.email is string
      &&
      request.resource.data.email == request.auth.token.email
      &&
      request.resource.data.avatarUrl is string
      &&
      request.resource.data.createdAt is int;
    }

    // حسابات اللاعبين
    match /players/{uid} {

      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid)
                    && validPlayerData(uid);

      allow update: if isOwner(uid)
                    &&
                    request.resource.data
                      .diff(resource.data)
                      .affectedKeys()
                      .hasOnly(['displayName'])
                    &&
                    request.resource.data.displayName is string
                    &&
                    request.resource.data.displayName.size() >= 1
                    &&
                    request.resource.data.displayName.size() <= 40
                    &&
                    request.resource.data.userId == uid
                    &&
                    request.resource.data.email == resource.data.email
                    &&
                    request.resource.data.avatarUrl == resource.data.avatarUrl
                    &&
                    request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;

      // بيانات التقدم الخاصة بصاحب الحساب فقط
      match /systemData/{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // محافظ SYSTEM الافتراضية: قراءة المالك فقط، والكتابة عبر Cloud Functions حصراً.
    match /systemWallets/{uid} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;
    }

    // سجل ملكية القطع الأثرية: لا يستطيع العميل إنشاء أو نقل أو حذف ملكية.
    match /artifactOwnership/{uid}/items/{artifactId} {
      allow get, list: if isOwner(uid);
      allow create, update, delete: if false;
    }

    // بيانات المزادات والمزايدات لا تُقرأ مباشرة من العميل؛ التصفح والسجل يمران عبر Cloud Functions حتى لا تتسرب معرفات الحسابات الداخلية.
    match /marketplaceAuctions/{auctionId} {
      allow read, write: if false;

      match /bids/{bidId} {
        allow read, write: if false;
      }
    }

    // عروض التبادل تُعرض للطرفين عبر callable functions فقط؛ يمنع الوصول المباشر إلى معرفات الطرف الآخر.
    match /marketplaceExchanges/{exchangeId} {
      allow read, write: if false;
    }

    // سجل تاريخ ملكية القطع خاص ولا يقبل أي كتابة من العميل.
    match /artifactHistory/{artifactId}/events/{eventId} {
      allow read, write: if false;
    }

    // مكافآت العملة الافتراضية سجلات داخلية.
    match /marketplaceCurrencyAwards/{awardId} {
      allow read, write: if false;
    }

    // تصفح العروض النشطة يتم عبر callable functions التي تخفي UID البائع؛ لا قراءة مباشرة لوثائق السوق.
    match /marketplaceListings/{listingId} {
      allow read, write: if false;
    }

    // إيصالات الصفقات الخاصة تُعرض للمشارك عبر callable functions فقط.
    match /marketplaceTransactions/{transactionId} {
      allow read, write: if false;
    }

    match /artifactRewardEvents/{eventId} {
      allow read, write: if false;
    }

    // سجلات التدقيق ومعرّفات القطع العالمية داخلية بالكامل.
    match /marketplaceAudit/{recordId} {
      allow read, write: if false;
    }
    match /artifactOwnershipAudit/{artifactId} {
      allow read, write: if false;
    }
    match /artifactRegistry/{artifactId} {
      allow read, write: if false;
    }

    // الرسائل العالمية
    match /globalMessages/{messageId} {
      allow get, list: if signedIn()
                       &&
                       resource.data.moderationStatus == 'approved';

      allow create, update, delete: if false;
    }

    // المحادثات الخاصة
    match /privateChats/{chatId} {
      allow get, list: if signedIn()
                       &&
                       request.auth.uid in resource.data.memberIds;

      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow get, list: if signedIn()
                         &&
                         request.auth.uid in
                           get(
                             /databases/$(database)/documents/privateChats/$(chatId)
                           ).data.memberIds
                         &&
                         resource.data.moderationStatus == 'approved';

        allow create, update, delete: if false;
      }
    }

    // طلبات الصداقة
    match /friendRequests/{requestId} {
      allow read, write: if false;
    }

    // علاقات الصداقة
    match /friendships/{friendshipId} {
      allow read, write: if false;
    }

    // المجموعات
    match /chatGroups/{groupId} {
      allow read, write: if false;

      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    // بلاغات اللاعبين
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // سجلات الإشراف والعقوبات
    match /moderationEvents/{eventId} {
      allow read, write: if false;
    }

    // بيانات الحظر
    match /bannedUsers/{uid} {
      allow read, write: if false;
    }

    // منع أي وصول غير محدد
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
