
package com.system.irtqaa

import android.os.Bundle
import android.content.Context
import androidx.activity.ComponentActivity
import androidx.activity.compose.setContent
import androidx.compose.foundation.background
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale

private val Dark = Color(0xFF080D18)
private val Panel = Color(0xFF151F32)
private val Gold = Color(0xFFFFC857)
private val White = Color(0xFFF4F6FA)
private val Muted = Color(0xFF9BA9BD)

private data class SystemTask(
    val title: String,
    val area: String
)

private val areas = listOf(
    "الروح" to "التوازن والقيم والجانب الروحي",
    "العقل" to "المعرفة والتعلم وتنمية التفكير",
    "الجسد" to "الصحة واللياقة والقوة البدنية",
    "الوعي" to "الفهم والتركيز ومراقبة الذات",
    "الانضباط" to "الالتزام والاستمرار وتحقيق الأهداف"
)

private val tasks = listOf(
    SystemTask("استيقظ مبكراً", "الانضباط"),
    SystemTask("اقرأ لمدة 20 دقيقة", "العقل"),
    SystemTask("مارس التمارين الرياضية", "الجسد"),
    SystemTask("خصص وقتاً للتأمل", "الروح"),
    SystemTask("راجع أهدافك اليومية", "الوعي")
)

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        val prefs = getSharedPreferences("system_data", Context.MODE_PRIVATE)
        val today = SimpleDateFormat("yyyyMMdd", Locale.US).format(Date())

        if (prefs.getString("day", "") != today) {
            val editor = prefs.edit()
            tasks.indices.forEach { index ->
                editor.remove("task_$index")
            }
            editor.putString("day", today)
            editor.apply()
        }

        setContent {
            SystemApp(prefs)
        }
    }
}

@Composable
fun SystemApp(prefs: android.content.SharedPreferences) {
    var page by remember { mutableIntStateOf(0) }

    var xp by remember {
        mutableIntStateOf(prefs.getInt("xp", 0))
    }

    val completed = remember {
        mutableStateListOf<Boolean>().apply {
            tasks.indices.forEach { index ->
                add(prefs.getBoolean("task_$index", false))
            }
        }
    }

    val areaXp = remember {
        mutableStateMapOf<String, Int>().apply {
            areas.forEach { area ->
                put(area.first, prefs.getInt("area_${area.first}", 0))
            }
        }
    }

    val level = (xp / 50) + 1
    val progress = (xp % 50) / 50f
    val completedCount = completed.count { it }

    MaterialTheme {
        Scaffold(
            containerColor = Dark,
            bottomBar = {
                NavigationBar(containerColor = Panel) {
                    listOf("الرئيسية", "المهام", "المستويات").forEachIndexed { index, label ->
                        NavigationBarItem(
                            selected = page == index,
                            onClick = { page = index },
                            icon = {
                                Text(
                                    listOf("⌂", "✓", "★")[index],
                                    fontSize = 20.sp
                                )
                            },
                            label = { Text(label, color = White) },
                            colors = NavigationBarItemDefaults.colors(
                                selectedIconColor = Gold,
                                indicatorColor = Color(0xFF34425B)
                            )
                        )
                    }
                }
            }
        ) { padding ->

            LazyColumn(
                modifier = Modifier
                    .fillMaxSize()
                    .background(Dark)
                    .padding(padding)
                    .padding(18.dp),
                verticalArrangement = Arrangement.spacedBy(16.dp)
            ) {

                item {
                    Text(
                        "SYSTEM",
                        color = Gold,
                        fontSize = 30.sp,
                        fontWeight = FontWeight.Bold
                    )
                    Text(
                        "الإنسان نحو الارتقاء",
                        color = Muted,
                        fontSize = 15.sp
                    )
                }

                item {
                    Card(
                        colors = CardDefaults.cardColors(containerColor = Panel),
                        shape = RoundedCornerShape(18.dp),
                        modifier = Modifier.fillMaxWidth()
                    ) {
                        Column(Modifier.padding(20.dp)) {
                            Text("مستوى المستخدم", color = Muted)

                            Text(
                                "LEVEL $level",
                                color = Gold,
                                fontSize = 34.sp,
                                fontWeight = FontWeight.Bold
                            )

                            Text("$xp XP", color = White)

                            Spacer(Modifier.height(12.dp))

                            LinearProgressIndicator(
                                progress = { progress },
                                modifier = Modifier.fillMaxWidth(),
                                color = Gold,
                                trackColor = Dark
                            )

                            Text(
                                "${xp % 50} / 50 XP للمستوى التالي",
                                color = Muted,
                                fontSize = 12.sp
                            )
                        }
                    }
                }

                item {
                    Text(
                        when (page) {
                            1 -> "المهام اليومية"
                            2 -> "مجالات التطور"
                            else -> "لوحة التحكم"
                        },
                        color = White,
                        fontSize = 22.sp,
                        fontWeight = FontWeight.Bold
                    )
                }

                if (page == 0) {

                    item {
                        Card(
                            colors = CardDefaults.cardColors(containerColor = Panel),
                            shape = RoundedCornerShape(16.dp),
                            modifier = Modifier.fillMaxWidth()
                        ) {
                            Column(Modifier.padding(18.dp)) {
                                Text("إنجازات اليوم", color = Gold, fontSize = 18.sp)
                                Spacer(Modifier.height(8.dp))
                                Text(
                                    "$completedCount من ${tasks.size} مهام مكتملة",
                                    color = White,
                                    fontSize = 16.sp
                                )
                                Text(
                                    "استمر بالتقدم، كل خطوة تصنع فرقاً.",
                                    color = Muted,
                                    fontSize = 13.sp
                                )
                            }
                        }
                    }

                    item {
                        Text(
                            "مجالات التطور",
                            color = White,
                            fontSize = 19.sp,
                            fontWeight = FontWeight.Bold
                        )
                    }

                    items(areas.size) { index ->
                        val area = areas[index]
                        AreaCard(
                            name = area.first,
                            description = area.second,
                            xp = areaXp[area.first] ?: 0
                        )
                    }

                } else if (page == 1) {

                    items(tasks.size) { index ->
                        val task = tasks[index]

                        Card(
                            colors = CardDefaults.cardColors(containerColor = Panel),
                            shape = RoundedCornerShape(14.dp),
                            modifier = Modifier.fillMaxWidth()
                        ) {
                            Row(
                                modifier = Modifier.padding(14.dp),
                                verticalAlignment = Alignment.CenterVertically
                            ) {
                                Checkbox(
                                    checked = completed[index],
                                    onCheckedChange = { checked ->
                                        if (checked != completed[index]) {
                                            completed[index] = checked

                                            val change = if (checked) 10 else -10
                                            xp = (xp + change).coerceAtLeast(0)

                                            val oldAreaXp = areaXp[task.area] ?: 0
                                            areaXp[task.area] =
                                                (oldAreaXp + change).coerceAtLeast(0)

                                            prefs.edit()
                                                .putBoolean("task_$index", checked)
                                                .putInt("xp", xp)
                                                .putInt(
                                                    "area_${task.area}",
                                                    areaXp[task.area] ?: 0
                                                )
                                                .apply()
                                        }
                                    },
                                    colors = CheckboxDefaults.colors(
                                        checkedColor = Gold
                                    )
                                )

                                Column(Modifier.weight(1f)) {
                                    Text(
                                        task.title,
                                        color = White,
                                        fontWeight = FontWeight.Medium
                                    )
                                    Text(
                                        "${task.area}  •  +10 XP",
                                        color = Gold,
                                        fontSize = 12.sp
                                    )
                                }
                            }
                        }
                    }

                } else {

                    items(areas.size) { index ->
                        val area = areas[index]

                        AreaCard(
                            name = area.first,
                            description = area.second,
                            xp = areaXp[area.first] ?: 0
                        )
                    }
                }

                item {
                    Spacer(Modifier.height(10.dp))
                    Text(
                        "كل يوم فرصة جديدة لتصبح أفضل.",
                        color = Muted,
                        modifier = Modifier.fillMaxWidth(),
                        fontSize = 14.sp
                    )
                }
            }
        }
    }
}

@Composable
fun AreaCard(
    name: String,
    description: String,
    xp: Int
) {
    val areaLevel = (xp / 50) + 1
    val progress = (xp % 50) / 50f

    Card(
        colors = CardDefaults.cardColors(containerColor = Panel),
        shape = RoundedCornerShape(14.dp),
        modifier = Modifier.fillMaxWidth()
    ) {
        Column(Modifier.padding(18.dp)) {

            Text(
                name,
                color = Gold,
                fontSize = 19.sp,
                fontWeight = FontWeight.Bold
            )

            Text(
                description,
                color = Muted,
                fontSize = 13.sp
            )

            Spacer(Modifier.height(10.dp))

            Text(
                "LEVEL $areaLevel  •  $xp XP",
                color = White,
                fontSize = 14.sp
            )

            Spacer(Modifier.height(8.dp))

            LinearProgressIndicator(
                progress = { progress },
                modifier = Modifier.fillMaxWidth(),
                color = Gold,
                trackColor = Dark
            )

            Text(
                "${xp % 50} / 50 XP للمستوى التالي",
                color = Muted,
                fontSize = 11.sp
            )
        }
    }
}
